// Eurogar — ma'lumotlar bazasi sxemasi (PostgreSQL).
// DATABASE_URL bo'lmasa, ilova avvalgidek xotira rejimida ishlayveradi
// (src/lib/repo.ts dagi fallback) — dev uchun baza shart emas.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  categorySlug String
  /// {uz, ru}
  name         Json
  /// {uz, ru}
  description  Json
  /// so'mda
  price        Int
  oldPrice     Int?
  /// {uz, ru} — dona / m² / komplekt
  unit         Json
  stock        Int      @default(0)
  images       String[]
  badges       String[]
  /// [{label:{uz,ru}, value:{uz,ru}}]
  specs        Json     @default("[]")
  featured     Boolean  @default(false)
  hidden       Boolean  @default(false)
  /** ro'yxatdagi tartib — kichigi birinchi */
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([categorySlug])
  @@index([hidden])
}

model Order {
  id        String   @id @default(cuid())
  /// EG-1041 ko'rinishidagi kod shu raqamdan yasaladi
  codeNum   Int      @unique @default(autoincrement())
  name      String
  phone     String
  note      String   @default("")
  /// [{name:{uz,ru}, qty, price}]
  items     Json
  total     Int
  status    String   @default("new")
  source    String   @default("cart")
  createdAt DateTime @default(now())

  @@index([status])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  note      String   @default("")
  source    String   @default("contact")
  meta      Json?
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([status])
}

/// Formalarga spam himoyasi — IP + amal bo'yicha hisoblagich
model RateLimit {
  /// "<ip>:<action>", masalan "1.2.3.4:lead"
  id       String   @id
  count    Int      @default(0)
  /// joriy oyna boshlangan vaqt
  windowAt DateTime @default(now())

  @@index([windowAt])
}

model Review {
  id        String   @id @default(cuid())
  name      String
  /// saytda ko'rsatilmaydi — admin bog'lanishi uchun (ixtiyoriy)
  phone     String   @default("")
  /// 1–5
  rating    Int      @default(5)
  text      String
  /// pending → approved (saytda chiqadi) | rejected
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@index([status])
}
