# ── Ma'lumotlar bazasi (PostgreSQL) ─────────────────────────
# Bo'sh qoldirilsa sayt xotira rejimida ishlaydi (dev uchun qulay,
# lekin admin o'zgarishlari serverda restart'gacha yashaydi).
# Neon: https://vercel.com/marketplace/neon → "Connect" → DATABASE_URL
# Ulangach bir marta: bun run db:push  (jadvallarni yaratadi;
# katalog bo'sh bo'lsa mock mahsulotlar avtomatik seed bo'ladi)
DATABASE_URL=

# ── Rasmlar ombori (Vercel Blob) ────────────────────────────
# Vercel loyihada Storage → Blob yaratilsa token o'zi qo'shiladi.
# Bo'sh qoldirilsa rasmlar public/uploads ga yoziladi (faqat lokal dev;
# Vercel'da disk vaqtinchalik — prod uchun Blob shart).
BLOB_READ_WRITE_TOKEN=

# ── Admin panel ──────────────────────────────────────────────
# /admin ga kirish paroli. Prod'da albatta o'zgartiring.
ADMIN_PASSWORD=eurogar2026

# ── Telegram bot ─────────────────────────────────────────────
# @BotFather dan olingan token. Bo'sh qoldirilsa — xabarlar
# konsolga yoziladi va sayt xatosiz ishlayveradi.
TELEGRAM_BOT_TOKEN=
# Menejerlar guruhi ID si. Olish yo'li: botni guruhga qo'shib,
# guruhda /id deb yozing — bot o'zi aytadi. (masalan: -1001234567890)
TELEGRAM_CHAT_ID=
# Webhook himoyasi — istalgan maxfiy satr; bun run tg:setup taklif qiladi.
# .env.local va Vercel'da BIR XIL bo'lishi shart.
TELEGRAM_WEBHOOK_SECRET=
# Sozlash: token'ni qo'ygach →  bun run tg:setup https://sizning.vercel.app

# ── Sayt ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://eurogar.uz
